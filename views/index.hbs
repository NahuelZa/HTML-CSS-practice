<header class="bg-light d-flex justify-content-center p-3">
    <form class="d-flex gap-3" id="formulario-busqueda">
        <input type="text" placeholder="Buscar..." id="buscador-ciudad" name="buscador-ciudad" class="form-control">
        <button type="submit" id="boton-buscar-ciudad" class="btn btn-primary">Buscar</button>
    </form>
</header>

<div class="container-fluid mt-3">
    <div class="row g-3">        
        <!-- Mapa: Arriba en móviles (order-1), a la derecha en PC (order-md-2, col-md-9) -->
        <main class="col-12 col-md-9 order-1 order-md-2 d-flex flex-column">            
            <div id="map" class="w-100" style="min-height: 500px;"></div>

            <div class="mt-3">
                Weather
                <div id="info-clima"></div>
            </div>
            
            <div class="justify-content-start mt-3">
                <button class="btn btn-primary" id="boton-guardar-direccion">Guardar</button>
            </div>
        </main>

        <!-- Tabla: Abajo en móviles (order-2), a la izquierda en PC (order-md-1, col-md-3) -->
        <aside class="col-12 col-md-3 order-2 order-md-1">
            <div class="table-responsive">
                <table class="table table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th scope="col">Coordenadas</th>
                            <th scope="col">Ciudad</th>
                        </tr>
                    </thead>
                    <tbody id="data-table">
                    </tbody>
                </table>
            </div>
        </aside>

    </div>
</div>