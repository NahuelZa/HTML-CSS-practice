<main class="col-12 col-md-8 col-lg-9 order-1 order-md-2 d-flex flex-column gap-3" id="map-panel">
  <div id="map"></div>

  <div class="row g-3">
    <div class="col-12 col-lg-8">
      <div class="panel-label mb-2">Clima actual</div>
      <div class="weather-card empty" id="info-clima">Buscá una ciudad para ver su clima.</div>
    </div>
    <div class="col-12 col-lg-4 d-flex align-items-end">
      <button class="btn w-100" id="boton-guardar-direccion">Guardar lugar</button>
    </div>
  </div>
  <div class="status-msg" id="mensaje-estado" role="status" aria-live="polite"></div>
</main>
