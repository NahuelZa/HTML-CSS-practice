<div class="header d-flex justify-content-between align-items-center" style="height: 40px">
    <div style="height: 30px" class="d-flex align-items-center gap-2 h-50">
        <a class="icon-link h-50" href="#">
            <img src="{{communityImage}}"
                class="bi" viewBox="0 0 16 16" aria-hidden="true">
            <path
                d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2l-2.218-.887zm3.564 1.426L5.596 5 8 5.961 14.154 3.5l-2.404-.961zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923l6.5 2.6zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464L7.443.184z" />
            </img>
            {{community}}
        </a>

        <p class="fw-lighter h-50 mb-3">hace 16 horas</p>
    </div>



    <div class="head-der d-flex gap-2 align-items-stretch justify-content-end h-50">
        <button type="button"
            class="btn btn-light fw-bold rounded-pill h-100 px-3 d-inline-flex align-items-center justify-content-center">
            Unirse
        </button>

        <div class="dropdown">
            <button class="btn d-inline-flex btn-secondary dropdown-toggle border-0" type="button"
                data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-ellipsis"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fa-solid fa-door-open"></i>
                        <span>Log In / Sign Up</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fa-solid fa-arrow-pointer"></i>
                        <span>Advertise in Reddit</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fa-solid fa-gear"></i>
                        <span>Cookie Preferences</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Try Reddit Pro <span class="text-primary fw-bold">BETA</span></span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fa-solid fa-toggle-on"></i>
                        <span>Display Mode</span>
                    </a>
                </li>
            </ul>
        </div>

    </div>

</div>


<div class="body-post d-block">
    <h1>{{title}}</h1>
    <img src="{{image}}"
        class="img-fluid rounded-4" alt="...">
</div>

<div class="footer d-flex mt-1 gap-3">
    <div class="vote small p-2 my-0 bg-body-tertiary rounded-5 d-flex align-items-center justify-content-center gap-1">
        <i class="fa-solid fa-arrow-up"></i> {{likes}} <i class="fa-solid fa-arrow-down"></i>
    </div>
    <div class="comment small p-2 my-0 bg-body-tertiary rounded-5 d-flex align-items-center justify-content-center gap-1">
        <i class="fa-solid fa-comment"></i> {{comments}}
    </div>
    <div class="share small p-2 my-0 bg-body-tertiary rounded-5 d-flex align-items-center justify-content-center gap-1">
        <i class="fa-solid fa-share"></i> {{shares}}
    </div>



</div>