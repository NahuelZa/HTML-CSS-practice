@import 'bootstrap/dist/css/bootstrap.css';
@import '@fortawesome/fontawesome-free/css/all.css';

.navbar {
    .logo {
        height: 2rem;
    }

    .logo,
    .input-logo {
        color: var(--bs-primary);
        fill: var(--bs-primary);
    }

    .searchbar {
        width: 30rem;

        &:focus-within {
            border-color: black !important  ;
        }
    }

    form {
        input[type="text"] {
            border: 0;
            background-color: rgba(var(--bs-tertiary-bg-rgb), var(--bs-bg-opacity)) !important;

            &:focus {
                outline: none;
            }
        }
    }

    .dropstart {
        .dropdown-toggle {
            background-color: rgba(var(--bs-tertiary-bg-rgb), var(--bs-bg-opacity)) !important;

            &:before {
                content: none;
            }

            i {
                color: var(--bs-secondary);
            }
        }
    }
 
}


.header{
    .dropdown{
        .btn-light {
    --bs-btn-bg: transparent;
    --bs-btn-border-color: transparent;
        }
    }

.icon-link{    
    color: var(--bs-secondary);
    text-decoration: none;
    &:hover{
        color: rgba(3, 11, 22, 0.29);
    }

}

   


       
 }
  .icon-link > .bi {    
    width: 2em;
    height: 2em;    
    border-radius: 5em;
    
}

 .head-der{
    .dropdown {
            .dropdown-toggle {
                background-color: transparent  !important;

                &:before {
                    content: none;
                }

                i {
                    color: var(--bs-secondary);
                }
            }
        }
 }

.articulos {
  transition: background-color 0.2s ease; 

  &:hover {
    background-color: var(--bs-secondary-bg) !important;
    cursor: pointer;
  }
}

.footer{
    .fa-solid{
        &:hover{
            color: var(--bs-primary);
        }
    }
}

.contenedor-aside{

    .imagen-y-texto{

    &:hover{
        background-color: rgba(226, 235, 226, 0.25) !important;
        cursor: pointer;
    }

.texto{
    h6{
        margin: 0;
    }
    p{
        margin: 0;
    }
}


}
.btn-dark{
    --bs-btn-bg: transparent;
    --bs-btn-border-color: transparent;
}

}

