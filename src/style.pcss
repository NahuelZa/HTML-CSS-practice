@import 'bootstrap/dist/css/bootstrap.css';
@import '@fortawesome/fontawesome-free/css/all.css';

:root{
  --deep-chart:#16233F;
  --deep-chart-2:#1D2E52;
  --parchment:#EFE8D8;
  --parchment-2:#E4DAC3;
  --cloud:#FBFAF6;
  --brass:#B8892B;
  --brass-light:#D9B563;
  --meridian:#2F6E73;
  --storm:#C1432B;
  --ink:#16233F;
  --ink-soft:rgba(22,35,63,.62);
  --font-display:'Fraunces', serif;
  --font-body:'Inter', sans-serif;
  --font-mono:'JetBrains Mono', monospace;
}

body{
  background:
    radial-gradient(circle at 15% 0%, rgba(184,137,43,.08), transparent 45%),
    var(--parchment);
  color:var(--ink);
  font-family:var(--font-body);
  min-height:100vh;
}

/* ---------- HEADER ---------- */
.chart-header{
  background:linear-gradient(180deg, var(--deep-chart) 0%, var(--deep-chart-2) 100%);
  border-bottom:3px solid var(--brass);
  position:relative;
  overflow:hidden;
}
.chart-header .compass-mark{
  position:absolute;
  right:-30px; top:50%; transform:translateY(-50%);
  opacity:.14;
  width:170px; height:170px;
  pointer-events:none;
}
.brand-eyebrow{
  font-family:var(--font-mono);
  font-size:.68rem;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--brass-light);
}
.brand-title{
  font-family:var(--font-display);
  font-weight:600;
  font-size:clamp(1.4rem, 2.4vw, 1.9rem);
  color:var(--cloud);
  margin:0;
}
.search-shell{
  background:var(--cloud);
  border:1.5px solid var(--brass);
  border-radius:.6rem;
  padding:.35rem;
  box-shadow:0 8px 24px rgba(22,35,63,.25);
}
#buscador-ciudad{
  border:none;
  background:transparent;
  font-family:var(--font-body);
  font-size:.98rem;
  color:var(--ink);
  padding:.55rem .75rem;
}
#buscador-ciudad:focus{ outline:none; box-shadow:none; }
#buscador-ciudad::placeholder{ color:var(--ink-soft); }
#boton-buscar-ciudad{
  background:var(--brass);
  border:none;
  color:var(--deep-chart);
  font-weight:600;
  font-size:.9rem;
  padding:.55rem 1.2rem;
  border-radius:.4rem;
  transition:background .15s ease, transform .1s ease;
}
#boton-buscar-ciudad:hover{ background:var(--brass-light); }
#boton-buscar-ciudad:active{ transform:scale(.97); }
#boton-buscar-ciudad:focus-visible, #buscador-ciudad:focus-visible{
  outline:2px solid var(--brass-light); outline-offset:2px;
}

/* ---------- MAPA ---------- */
#map-panel{ animation:riseIn .5s ease both; }
@keyframes riseIn{
  from{ opacity:0; transform:translateY(10px); }
  to{ opacity:1; transform:translateY(0); }
}
@media (prefers-reduced-motion: reduce){ #map-panel{ animation:none; } }

#map{
  border:2px solid var(--brass);
  border-radius:.75rem;
  overflow:hidden;
  box-shadow:0 10px 28px rgba(22,35,63,.15);
  min-height:420px;
}
@media (min-width: 768px){ #map{ min-height:520px; } }

.panel-label{
  font-family:var(--font-mono);
  font-size:.7rem;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--meridian);
}

/* ---------- CLIMA ---------- */
.weather-card{
  background:var(--cloud);
  border:1.5px solid var(--parchment-2);
  border-left:4px solid var(--meridian);
  border-radius:.6rem;
  padding:1rem 1.25rem;
  min-height:96px;
}
.weather-card.empty{ color:var(--ink-soft); font-style:italic; display:flex; align-items:center; }
.weather-temp{ font-family:var(--font-display); font-weight:600; font-size:2.1rem; color:var(--deep-chart); line-height:1; }
.weather-desc{ font-size:.92rem; color:var(--ink-soft); }
.weather-stats{
  font-family:var(--font-mono);
  font-size:.78rem;
  color:var(--meridian);
  display:flex; gap:1.1rem; flex-wrap:wrap; margin-top:.35rem;
}

/* ---------- BOTON GUARDAR ---------- */
#boton-guardar-direccion{
  background:var(--brass);
  color:var(--deep-chart);
  border:none;
  font-weight:600;
  padding:.6rem 1.4rem;
  border-radius:.4rem;
  transition:background .15s ease, transform .1s ease;
}
#boton-guardar-direccion:hover{ background:var(--brass-light); }
#boton-guardar-direccion:active{ transform:scale(.97); }
#boton-guardar-direccion:disabled{ background:var(--parchment-2); color:var(--ink-soft); cursor:not-allowed; }
#boton-guardar-direccion:focus-visible{ outline:2px solid var(--meridian); outline-offset:2px; }

/* ---------- TABLA / INDICE ---------- */
.log-panel{
  background:var(--cloud);
  border:1.5px solid var(--parchment-2);
  border-radius:.75rem;
  overflow:hidden;
  box-shadow:0 6px 18px rgba(22,35,63,.08);
}
.log-panel-head{
  background:var(--deep-chart);
  color:var(--parchment);
  padding:.8rem 1rem;
  display:flex; align-items:baseline; justify-content:space-between;
}
.log-panel-head h2{ font-family:var(--font-display); font-size:1.05rem; font-weight:600; margin:0; }
.log-count{ font-family:var(--font-mono); font-size:.72rem; color:var(--brass-light); }

table.gazette{ width:100%; margin:0; border-collapse:separate; border-spacing:0; }
table.gazette thead th{
  font-family:var(--font-mono);
  font-size:.68rem;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--meridian);
  background:var(--parchment);
  padding:.6rem .9rem;
  border-bottom:1px solid var(--parchment-2);
}
table.gazette tbody tr{
  border-bottom:1px dashed var(--parchment-2);
  cursor:pointer;
  transition:background .12s ease, border-left-color .12s ease;
  border-left:3px solid transparent;
}
table.gazette tbody tr:hover, table.gazette tbody tr:focus-within{
  background:rgba(47,110,115,.08);
  border-left-color:var(--brass);
}
table.gazette tbody td{ padding:.65rem .9rem; font-size:.88rem; vertical-align:middle; }
table.gazette td.coords{ font-family:var(--font-mono); font-size:.78rem; color:var(--meridian); white-space:nowrap; }
table.gazette td.city{ font-weight:600; color:var(--ink); }

.empty-log{ padding:1.6rem 1rem; text-align:center; color:var(--ink-soft); font-size:.88rem; }
.empty-log .glyph{ font-size:1.4rem; display:block; margin-bottom:.3rem; }

.status-msg{ font-size:.85rem; padding:.4rem .1rem; min-height:1.4rem; }
.status-msg.error{ color:var(--storm); }
.status-msg.ok{ color:var(--meridian); }
