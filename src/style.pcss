:root {
  --color-primario: #132620;
  --color-brand-blue-dark: #0a2540;
  --color-brand-blue-mid: #1a5c7c;
  --color-brand-blue-text: #0b3b60;
  --color-brand-teal: #288c92;
  --color-accent-orange: #ff6b4a;

  /* Fondos y Neutros */
  --color-fondo-app: #f0f0f0;
  --color-fondo-tarjeta: #f8fafc;
  --color-fondo-tarjeta-hover: #f1f5f9;
  --color-banner-bg: #edf8ff;
  --color-blanco: #ffffff;
  
  /* Textos */
  --color-texto-main: #333333;
  --color-texto-dark: #1e293b;
  --color-texto-muted: #808080;
  --color-texto-muted-light: #777777;

  /* Hovers */
  --color-hover-lavender: #ded9ff;
  --color-focus: #acbe06;

  /* Bordes y Sombras */
  --color-borde: #ddd;
  --color-borde-light: #eaeaea;
  --sombra-dropdown: rgba(0, 0, 0, 0.15);
}


* {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  font-family: sans-serif;
}

body {
  background-color: var(--color-fondo-app);
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/*HEADER*/
.header-color {
  background: linear-gradient(135deg, var(--color-brand-blue-dark) 0%, var(--color-brand-blue-mid) 100%);
  display: inline-block;
  margin: 0 auto;
  overflow: hidden;
  width: 100%;
}

.banner {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  background-color: var(--color-banner-bg);

  p {
    background: red;

    &:hover {
      background: blue;
    }
  }
}

.banner-izq {
  display: block;
  margin: 10px;
  margin-left: 50px;
}

.evento-titulo {
  color: var(--color-brand-blue-text);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.3;
}

.evento-descripcion {
  color: var(--color-texto-dark);
  font-size: 14px;
  line-height: 1.5;
}

.banner-der {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 10px;
  gap: 1rem;
  margin-right: 50px;
}

.boton-baner {
  padding: 12px 24px;
  border-radius: 15px;
  background-color: transparent;
  font-weight: bold;
  border: 1.5px solid var(--color-brand-teal);
  transition: all 0.2s ease-in-out;
}

.boton-baner:hover {
  color: var(--color-hover-lavender);
  cursor: pointer;
}

.cerrar-banner {
  background-color: transparent;
  border: none;
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.cerrar-banner:hover {
  cursor: pointer;
}

/*NAV*/
.header-contenedor {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 20px;
}

.nav-izquierda {
  display: flex;
  justify-content: flex-start;
  gap: 2rem;
}

.nav-derecha {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 9px;

  a,
  p {
    color: var(--color-blanco);
    text-decoration: none;
    font-weight: bold;
  }
}

.links-nav {
  display: flex;
  gap: 2em;
  align-items: center;
}

.links-nav li {
  list-style-type: none;
}

.links-nav li a {
  text-decoration: none;
  color: var(--color-blanco);
  font-weight: bold;
}

.dropdown {
  display: flex;
  flex-direction: column;
}

.hasDropdown {
  position: relative;
}

.subDropdown {
  display: none;
  position: absolute;
  top: 130%;
  left: 0;
  background-color: var(--color-blanco);
  box-shadow: 0px 8px 16px var(--sombra-dropdown);
  padding: 20px;
  border-radius: 8px;
  z-index: 999;
  gap: 2.5rem;
  min-width: 600px;
}

.hasDropdown:hover .subDropdown {
  display: flex;
}

.hasDropdown:not(:hover) .subDropdown {
  display: none;
}

/*PORTADA*/
.portada {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  padding: 40px 20px;
}

.portada-izquierda {
  padding-right: 20px;
  flex: 1;
  color: var(--color-blanco);
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: flex-start;
}

.portada-derecha {
  display: flex;
  justify-content: center;
  align-items: center;
  flex: 1;
}

.portada-derecha img {
  max-width: 70%;
  height: auto;
  border-radius: 10px;
}

.boton-primario {
  background-color: var(--color-accent-orange);
  color: var(--color-blanco);
  border: none;
  padding: 10px 20px;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

.boton-primario:hover {
  border-radius: 50px;
}

.menu-card {
  display: flex;
  align-items: center;
  background-color: var(--color-fondo-tarjeta);
  border-radius: 12px;
  padding: 12px 16px;
  text-decoration: none;
  color: var(--color-texto-muted);
  font-weight: 600;
  font-size: 14px;
  transition: background-color 0.2s ease, transform 0.2s ease;
  white-space: nowrap;
}

.menu-card span {
  color: var(--color-texto-muted);
}

.menu-card:hover {
  background-color: var(--color-fondo-tarjeta-hover);
  transform: translateY(-1px);
}

.foto-menu {
  width: 32px;
  height: 32px;
  margin-right: 12px;
  object-fit: contain;
}

.menu-cards {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}